---
// 关于页「地球Online」时间线卡片（参考站同款：色块偏移阴影 + 图标方块）
import Icon from './Icon.astro'
const { t, align = 'right' } = Astro.props
const isLeft = align === 'left'
---
<div class="relative group {isLeft ? 'md:mr-10' : 'md:ml-10'}">
  <div class="absolute -right-2 -bottom-2 w-full h-full border-black border-2 rounded-2xl -z-10 transition-transform group-hover:translate-x-1 group-hover:translate-y-1" style={`background-color:${t.color}`}></div>
  <div class={`bg-white neo-border p-4 md:p-5 rounded-2xl shadow-lg flex items-center gap-4 ${isLeft ? '' : 'md:flex-row-reverse'}`}>
    <div class="w-12 h-12 neo-border rounded-xl flex items-center justify-center flex-shrink-0" style={`background-color:${t.color}`}>
      <Icon name={t.icon} size={22} cls="text-black" />
    </div>
    <div class={`flex-1 ${isLeft ? 'text-left' : 'md:text-right'}`}>
      <div class={`flex items-center gap-2 mb-1 ${isLeft ? '' : 'md:justify-end'}`}>
        <span class="text-[10px] font-black bg-black text-white px-1.5 py-0.5 rounded uppercase tracking-tighter">【{t.kind}】</span>
        <span class="font-black text-lg">{t.date}</span>
      </div>
      <p class="text-gray-800 font-bold leading-tight text-sm md:text-base">{t.text}</p>
    </div>
  </div>
</div>
