---
/* 可交互能力演示：不是告诉你我会，而是让你亲手摸到差别。 */
---

<section class="demos">
  <div class="dcard">
    <span class="en">Hover</span>
    <h4>悬停反馈</h4>
    <p class="note">鼠标放上去，按钮变色并浮起，让人一眼知道它能点。</p>
    <div class="demo-stage">
      <button class="btn" type="button">悬停我 · 浮起变色</button>
      <button class="btn dead" type="button">对照组 · 不响应</button>
    </div>
  </div>

  <div class="dcard">
    <span class="en">Spring</span>
    <h4>弹性动效</h4>
    <p class="note">先越过目标值再回弹，像弹簧那样轻轻晃一下。</p>
    <div class="demo-stage">
      <div class="track"><div class="block" data-spring></div></div>
      <button class="btn solid" type="button" data-spring-btn>重播</button>
    </div>
  </div>

  <div class="dcard">
    <span class="en">Backdrop Blur</span>
    <h4>毛玻璃外观</h4>
    <p class="note">半透明导航栏，后面的内容滚过去时模模糊糊。</p>
    <div class="glass-wrap">
      <div class="glass-bar blur" data-glass>backdrop-filter: blur(10px)</div>
    </div>
    <label class="switch">
      <input type="checkbox" checked data-glass-toggle />
      <span>blur: on &nbsp;·&nbsp; 关掉再看看</span>
    </label>
  </div>
</section>

<script>
  // Spring：移除再添加 class 以重启动画
  const btn = document.querySelector('[data-spring-btn]')
  const block = document.querySelector('[data-spring]')
  if (btn && block) {
    const replay = () => {
      block.classList.remove('run')
      void block.offsetWidth
      block.classList.add('run')
    }
    btn.addEventListener('click', replay)
    // 首次进入视口时自动演示一次
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            replay()
            io.disconnect()
          }
        })
      },
      { threshold: 0.4 }
    )
    io.observe(block)
  }

  // 毛玻璃开关
  const toggle = document.querySelector('[data-glass-toggle]')
  const bar = document.querySelector('[data-glass]')
  if (toggle && bar) {
    toggle.addEventListener('change', () => {
      bar.classList.toggle('blur', toggle.checked)
      const label = toggle.parentElement?.querySelector('span')
      if (label) label.textContent = toggle.checked ? 'blur: on  ·  关掉再看看' : 'blur: off  ·  差别就在这里'
    })
  }
</script>
