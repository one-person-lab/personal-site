---
const { num, name, tag, desc, href, cta, demo } = Astro.props
---

<article class="pcard">
  <span class="pnum" aria-hidden="true">{num}</span>

  <div class="stage" aria-hidden="true">
    {demo === 'media' && (
      <svg viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice">
        <g class="rows">
          <g style="--d:0s">
            <rect x="26" y="24" width="196" height="30" rx="8" fill="#fff" opacity=".92" />
            <rect x="38" y="34" width="112" height="5" rx="2.5" fill="#1a1a1a" opacity=".5" />
            <circle cx="208" cy="39" r="4.5" fill="#1a1a1a" />
          </g>
          <g style="--d:.12s">
            <rect x="26" y="64" width="196" height="30" rx="8" fill="#fff" opacity=".92" />
            <rect x="38" y="74" width="86" height="5" rx="2.5" fill="#1a1a1a" opacity=".5" />
            <circle cx="208" cy="79" r="4.5" fill="#ffe28a" stroke="#1a1a1a" stroke-width="1.2" />
          </g>
          <g style="--d:.24s">
            <rect x="26" y="104" width="196" height="30" rx="8" fill="#fff" opacity=".92" />
            <rect x="38" y="114" width="128" height="5" rx="2.5" fill="#1a1a1a" opacity=".28" />
            <circle cx="208" cy="119" r="4.5" fill="none" stroke="#1a1a1a" stroke-width="1.2" opacity=".45" />
          </g>
        </g>
        <rect x="246" y="24" width="52" height="110" rx="8" fill="#1a1a1a" opacity=".06" />
        <text x="272" y="52" text-anchor="middle" font-size="9" fill="#1a1a1a" opacity=".5" font-family="ui-monospace,monospace">W1</text>
        <text x="272" y="80" text-anchor="middle" font-size="9" fill="#1a1a1a" opacity=".5" font-family="ui-monospace,monospace">W2</text>
        <text x="272" y="108" text-anchor="middle" font-size="9" fill="#1a1a1a" opacity=".5" font-family="ui-monospace,monospace">W3</text>
        <text x="272" y="126" text-anchor="middle" font-size="8" fill="#1a1a1a" opacity=".35" font-family="ui-monospace,monospace">排期</text>
      </svg>
    )}

    {demo === 'product' && (
      <svg viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice">
        <line x1="52" y1="84" x2="268" y2="84" stroke="#1a1a1a" stroke-width="1.5" opacity=".18" />
        <g>
          <circle cx="52" cy="84" r="9" fill="#1a1a1a" />
          <text x="52" y="112" text-anchor="middle" font-size="10" fill="#1a1a1a" opacity=".7">需求</text>
        </g>
        <g>
          <circle cx="124" cy="84" r="9" fill="#1a1a1a" />
          <text x="124" y="112" text-anchor="middle" font-size="10" fill="#1a1a1a" opacity=".7">设计</text>
        </g>
        <g>
          <circle cx="196" cy="84" r="9" fill="#ffe28a" stroke="#1a1a1a" stroke-width="1.5" />
          <text x="196" y="112" text-anchor="middle" font-size="10" fill="#1a1a1a" opacity=".7">开发</text>
        </g>
        <g>
          <circle cx="268" cy="84" r="9" fill="none" stroke="#1a1a1a" stroke-width="1.5" opacity=".35" />
          <text x="268" y="112" text-anchor="middle" font-size="10" fill="#1a1a1a" opacity=".45">验证</text>
        </g>
        <rect x="42" y="36" width="150" height="26" rx="7" fill="#fff" opacity=".9" />
        <text x="54" y="53" font-size="10" fill="#1a1a1a" opacity=".6">需求池 · 12 条待决策</text>
      </svg>
    )}

    {demo === 'career' && (
      <svg viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice">
        <g class="funnel">
          <rect x="60" y="28" width="200" height="24" rx="6" fill="#1a1a1a" opacity=".82" />
          <text x="70" y="44" font-size="10" fill="#fff">投递 48</text>
          <rect x="80" y="60" width="160" height="24" rx="6" fill="#1a1a1a" opacity=".62" />
          <text x="90" y="76" font-size="10" fill="#fff">初筛 21</text>
          <rect x="100" y="92" width="120" height="24" rx="6" fill="#1a1a1a" opacity=".44" />
          <text x="110" y="108" font-size="10" fill="#fff">面试 8</text>
          <rect x="120" y="124" width="80" height="24" rx="6" fill="#ffe28a" stroke="#1a1a1a" stroke-width="1.2" />
          <text x="132" y="140" font-size="10" fill="#1a1a1a">Offer 2</text>
        </g>
      </svg>
    )}

    {demo === 'build' && (
      <svg viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice">
        <line x1="60" y1="84" x2="260" y2="84" stroke="#1a1a1a" stroke-width="1.5" opacity=".18" />
        <rect x="40" y="64" width="40" height="40" rx="9" fill="#1a1a1a" />
        <text x="60" y="88" text-anchor="middle" font-size="9" fill="#fff" font-family="ui-monospace,monospace">src</text>
        <rect x="140" y="64" width="40" height="40" rx="9" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
        <text x="160" y="88" text-anchor="middle" font-size="9" fill="#1a1a1a" font-family="ui-monospace,monospace">build</text>
        <rect x="240" y="64" width="40" height="40" rx="9" fill="#fff" stroke="#1a1a1a" stroke-width="1.5" />
        <text x="260" y="88" text-anchor="middle" font-size="9" fill="#1a1a1a" font-family="ui-monospace,monospace">dist</text>
        <circle class="flow" cx="60" cy="84" r="4.5" fill="#ffe28a" stroke="#1a1a1a" stroke-width="1.2" />
        <text x="160" y="46" text-anchor="middle" font-size="10" fill="#1a1a1a" opacity=".55">一条命令，产物出门禁</text>
      </svg>
    )}

    {demo === 'kb' && (
      <svg viewBox="0 0 320 168" preserveAspectRatio="xMidYMid slice">
        <g stroke="#1a1a1a" stroke-width="1.1" opacity=".28">
          <line x1="160" y1="84" x2="78" y2="46" />
          <line x1="160" y1="84" x2="246" y2="48" />
          <line x1="160" y1="84" x2="72" y2="124" />
          <line x1="160" y1="84" x2="250" y2="122" />
          <line x1="160" y1="84" x2="160" y2="36" />
        </g>
        <circle cx="160" cy="84" r="15" fill="#1a1a1a" />
        <text x="160" y="88" text-anchor="middle" font-size="9" fill="#fff">KB</text>
        <g fill="#fff" stroke="#1a1a1a" stroke-width="1.4">
          <circle cx="78" cy="46" r="9" />
          <circle cx="246" cy="48" r="9" />
          <circle cx="72" cy="124" r="9" />
          <circle cx="250" cy="122" r="9" />
          <circle cx="160" cy="36" r="9" fill="#ffe28a" />
        </g>
        <text x="160" y="148" text-anchor="middle" font-size="10" fill="#1a1a1a" opacity=".55">知识网络 · 双向链接</text>
      </svg>
    )}
  </div>

  <div class="pcard-body">
    <h3>{name}<span class="tag">{tag}</span></h3>
    <p>{desc}</p>
    <a class="cta" href={href} target="_blank" rel="noopener">
      {cta} <span class="arw">→</span>
    </a>
  </div>
</article>

<style>
  .stage svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .rows g {
    animation: fadeUp 0.5s var(--ease) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .flow {
    animation: slide 2.6s var(--ease) infinite;
  }
  @keyframes slide {
    0%,
    12% {
      transform: translateX(0);
      opacity: 1;
    }
    55% {
      transform: translateX(200px);
      opacity: 1;
    }
    70%,
    100% {
      transform: translateX(200px);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rows g,
    .flow {
      animation: none;
    }
  }
</style>
