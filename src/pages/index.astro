---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { profile, products, skills, friends, ecosystem } from '../data/site.mjs'
---
<Base title={`${profile.brand} — 个人项目与产品`}>
  <div class="max-w-7xl mx-auto px-4">

    <!-- HERO（参考站 1:1：左文右卡，贴纸旋转高亮） -->
    <section class="py-12 md:py-24">
      <div class="flex flex-col lg:flex-row items-center gap-6 lg:gap-8">
        <div class="flex-1 space-y-8 order-1">


          <h1 class="text-4xl md:text-6xl xl:text-7xl font-black leading-[1.1] tracking-tight text-black">
            我是<br>
            <span class="inline-block bg-[#f472b6] px-4 py-1 border-[3px] border-black transform -rotate-1 transition-all duration-300 hover:scale-110 hover:-rotate-3 cursor-pointer">{profile.name}</span>,
            <br>A Solo Builder,
            <br>一个人转起<span class="inline-block bg-[#3b82f6] text-white px-4 py-1 border-[3px] border-black transform rotate-2 mt-2 transition-all duration-300 hover:scale-110 hover:rotate-3 cursor-pointer">产品生态</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 max-w-xl leading-relaxed font-medium">
            {profile.lede1}<br>
            {profile.lede2}<br>
            {profile.lede3}
          </p>
          <div class="pt-4">
            <a href="/about" class="inline-flex items-center gap-3 px-8 py-5 bg-black text-white font-black text-lg rounded-2xl shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transition-all duration-300 hover:translate-x-1 hover:translate-y-1 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
              <Icon name="user" size={22} />
              More about me
            </a>
          </div>
        </div>
        <!-- 头像插画卡 -->
        <div class="w-full lg:w-2/5 h-[400px] md:h-[500px] lg:h-[450px] neo-border bg-white rounded-[3rem] neo-shadow-lg overflow-hidden relative group order-2">
          <img src="/avatar.jpg" alt="醒醒老己 头像插画" class="w-full h-full object-contain" />
        </div>
      </div>
    </section>

    <!-- 生态飞轮（醒醒老己 · 个人产品生态） -->
    <section class="py-20 text-center">
      <h2 class="text-5xl md:text-6xl font-black mb-6">
        醒醒老己 <span class="bg-yellow-300 px-4 neo-border inline-block transform -rotate-2">个人产品生态</span>
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto mb-12 text-lg">
        核心不是把几个产品硬凑在一起，而是形成一个转起来的闭环。
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
        {ecosystem.flywheel.map((f, i) => (
          <>
            <div class={`px-7 py-3 font-black text-xl neo-border rounded-2xl neo-shadow ${i % 2 ? 'bg-pink-400 text-white' : 'bg-white text-black'}`}>{f}</div>
            {i < ecosystem.flywheel.length - 1 && <Icon name="arrow-right" size={22} cls="text-black" />}
          </>
        ))}
        <div class="w-full flex justify-center mt-2">
          <div class="flex items-center gap-2 text-sm font-black text-gray-500 uppercase tracking-widest">
            <Icon name="loop" size={16} /> 循环往复，越转越大
          </div>
        </div>
      </div>
      <div class="max-w-3xl mx-auto neo-border bg-[#fef08a] rounded-[2rem] px-8 py-8 neo-shadow-lg">
        <p class="font-black text-lg md:text-2xl leading-relaxed">{ecosystem.summary}</p>
        <p class="text-sm font-bold text-black/60 mt-4">{ecosystem.loopLine}</p>
      </div>
    </section>

    <!-- 产品区（生态里的六个产品） -->
    <section class="py-20 text-center">
      <h2 class="text-5xl md:text-6xl font-black mb-6">
        The <span class="bg-pink-400 px-4 neo-border inline-block transform -rotate-2">Product Line</span>
      </h2>
      <p class="text-gray-600 max-w-2xl mx-auto mb-16 text-lg">
        生态里的每一个产品：被看见、做成事、沉淀资产、创造价值。
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
        {products.map((p) => (
          <a href={p.href} target="_blank" rel="noopener" class="group neo-border rounded-[2.5rem] p-10 bg-white neo-shadow-lg transition-all hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            <div class="w-20 h-20 neo-border rounded-2xl flex items-center justify-center mb-10 mx-auto md:mx-0" style={`background-color:${p.color}`}>
              <Icon name={p.icon} size={36} cls="text-black" />
            </div>
            <h3 class="text-3xl font-black mb-2 group-hover:text-blue-600 transition-colors">{p.name}</h3>
            <div class="flex items-center gap-2 mb-6">
              <span class="px-2 py-0.5 neo-border rounded-lg text-[10px] font-black" style={`background-color:${p.color}`}>{p.tag}</span>
              <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">{p.status}</span>
            </div>
            <p class="text-gray-600 text-lg leading-relaxed">{p.desc}</p>
          </a>
        ))}
        <div class="neo-border rounded-[2.5rem] p-10 bg-white neo-shadow-lg relative overflow-hidden">
          <div class="flex items-center justify-center h-full min-h-[200px]">
            <div class="text-center">
              <div class="text-2xl font-black text-gray-400 mb-2">更多机器开发中…</div>
              <div class="text-xs font-bold text-gray-300 uppercase tracking-widest">Coming Soon</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 能力区（占参考站 Videos 的框架位：错位蓝块标题 + 三卡） -->
    <section class="py-20">
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-16 gap-6">
        <div class="relative">
          <div class="absolute -right-2 -bottom-2 w-full h-full bg-[#3b82f6] neo-border -z-10"></div>
          <h2 class="text-6xl md:text-7xl font-black tracking-tighter bg-white px-6 py-2 neo-border relative">Capabilities</h2>
        </div>
        <a href="/about" class="font-black text-lg hover:text-blue-600 transition-all flex items-center gap-2 group self-end mb-1">
          了解更多
          <Icon name="arrow-right" size={20} cls="group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {skills.map((s) => (
          <div class="group neo-border bg-white rounded-[2.5rem] overflow-hidden neo-shadow-lg transition-all group-hover:translate-x-1 group-hover:translate-y-1 group-hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
            <div class="relative aspect-video overflow-hidden border-b-2 border-black bg-gray-100 flex items-center justify-center">
              <Icon name="zap" size={56} cls="text-black" />
              <div class="absolute top-4 left-4 bg-black text-white px-3 py-1 neo-border text-xs font-black rounded-lg">{s.en}</div>
            </div>
            <div class="p-8 flex-grow flex flex-col justify-between bg-white">
              <div>
                <h3 class="text-2xl font-black mb-6 leading-tight group-hover:text-blue-600 transition-colors">{s.title}</h3>
                <p class="text-gray-500 text-sm font-medium">{s.desc}</p>
              </div>
              <div class="flex items-center justify-between pt-6 mt-6 border-t-2 border-dashed border-gray-200">
                <div class="flex items-center gap-2 text-gray-600">
                  <Icon name="target" size={18} cls="text-blue-500" />
                  <span class="text-sm font-black">{s.stat.label}</span>
                </div>
                <span class="text-sm font-black">{s.stat.value}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 友情链接跑马灯（参考站同款 CSS 动画） -->
    <div class="friend-marquee-container">
      <div class="friend-marquee-track">
        {[0, 1].map((dup) => (
          <>
            <span class="friend-card bg-title friend-title-card"><span class="friend-name">友情链接</span></span>
            {friends.map((f, i) => (
              <a href={f.href} class={`friend-card bg-color-${(i % 4) + 1}`}>
                <span class="friend-avatar"></span>
                <span class="friend-name">{f.name}</span>
              </a>
            ))}
          </>
        ))}
      </div>
    </div>
  </div>
</Base>
